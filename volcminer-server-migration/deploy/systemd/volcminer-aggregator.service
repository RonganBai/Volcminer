[Unit]
Description=VolcMiner Ubuntu Aggregator
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/volcminer-server-migration
EnvironmentFile=/opt/volcminer-server-migration/.env
ExecStart=/usr/bin/node /opt/volcminer-server-migration/src/server.js
Restart=always
RestartSec=5
CPUQuota=150%
MemoryMax=8G
TasksMax=1024
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
